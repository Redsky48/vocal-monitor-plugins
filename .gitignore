node_modules/
.DS_Store
*.log
.idea/
.vscode/

# Native plugin build artefacts (compile output is the .dex next to source).
build/
*.class

# Gradle daemon state — per-machine, regenerated on every build,
# would constantly show as "modified" in commits otherwise.
.gradle/

# Kotlin compiler session files — same story, per-machine state.
.kotlin/
*.salive

# RunTest.java I/O. test-input.wav is gitignored too because it
# typically contains the contributor's own voice — if you want to share
# a sample recording for reproducible plugin testing, force-add it
# manually (`git add -f tools/test-app/test-input.wav`).
tools/test-app/test-input.wav
tools/test-app/test-output.wav
# MeasureIR.java outputs (regenerated on every run).
tools/test-app/ir.wav
tools/test-app/ir-spectrogram.png
tools/test-app/ir-decay.png
tools/test-app/ir-stats.json
tools/test-app/test-original.png
tools/test-app/test-processed.png
tools/test-app/test-spec-original.png
tools/test-app/test-spec-processed.png
tools/test-app/test-stats.json

# One-off render snapshots produced while iterating on canvas-mode
# plugin visuals — Glow Meter / Spectrum / Vocal Tuner / NoiseGate /
# Compressor / Limiter / Auto-Tune / De-esser screenshots etc. The
# source PNGs aren't checked in; force-add specific ones for docs
# (`git add -f tools/test-app/<name>.png`).
tools/test-app/*.png
!tools/test-app/test-original.png
!tools/test-app/test-processed.png
